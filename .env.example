# Copy to .env and uncomment what you need. Docker Compose reads .env automatically.

# Host ports
# QUICKPIZZA_PORT=3333
# GRAFANA_PORT=3000
# VICTORIAMETRICS_PORT=8428
# K6_DASHBOARD_PORT=5665

# Resource limits ("hardware" of each server)
# QUICKPIZZA_CPUS=0.5
# QUICKPIZZA_MEM=192M
# DB_CPUS=0.5
# DB_MEM=256M
# VICTORIAMETRICS_CPUS=0.5
# VICTORIAMETRICS_MEM=256M
# GRAFANA_CPUS=0.25
# GRAFANA_MEM=256M
# TELEGRAF_CPUS=0.1
# TELEGRAF_MEM=96M
# PROXY_CPUS=0.1
# PROXY_MEM=32M

# Image versions
# QUICKPIZZA_VERSION=0.15.31
# POSTGRES_VERSION=18.6
# VICTORIAMETRICS_VERSION=v1.153.0
# GRAFANA_VERSION=13.2.3
# TELEGRAF_VERSION=1.40.1-alpine
# K6_VERSION=2.3.0
# NGINX_VERSION=1.30.4-alpine

# QUICKPIZZA_LOG_LEVEL=warn
